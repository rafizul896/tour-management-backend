<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Tour Booking Invoice - ExploreBangla</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family: Arial, Helvetica, sans-serif;
        color: #1e293b;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
        box-sizing: border-box;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
      }

      .header {
        padding: 28px 32px;
        border-bottom: 1px solid #f1f5f9;
        text-align: center;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .logo-text {
        font-size: 20px;
        font-weight: 600;
        color: #1e293b;
        vertical-align: middle;
      }

      .logo-text span {
        color: #f97316;
      }

      .content {
        padding: 36px 32px;
      }

      .title {
        margin: 0 0 12px;
        font-size: 24px;
        font-weight: 700;
        color: #0f172a;
      }

      .text {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: #475569;
      }

      .success-box {
        margin: 24px 0;
        padding: 16px;
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        text-align: center;
      }

      .success-title {
        margin: 0 0 5px;
        font-size: 16px;
        font-weight: 600;
        color: #166534;
      }

      .success-text {
        margin: 0;
        font-size: 13px;
        color: #15803d;
      }

      .invoice {
        width: 100%;
        border-collapse: collapse;
        margin: 24px 0;
      }

      .invoice td {
        padding: 14px 12px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 14px;
      }

      .invoice td:first-child {
        color: #64748b;
      }

      .invoice td:last-child {
        text-align: right;
        font-weight: 600;
        color: #0f172a;
      }

      .amount-row td {
        padding-top: 18px;
        border-bottom: none;
        font-size: 17px;
      }

      .amount {
        color: #f97316 !important;
        font-size: 18px !important;
      }

      .attachment {
        margin-top: 24px;
        padding: 14px 16px;
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        border-radius: 6px;
        font-size: 13px;
        line-height: 1.6;
        color: #7c2d12;
      }

      .footer {
        padding: 22px 32px;
        background-color: #f8fafc;
        border-top: 1px solid #f1f5f9;
        text-align: center;
      }

      .footer-text {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #94a3b8;
      }

      .brand {
        color: #f97316;
        font-weight: 600;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 12px;
        }

        .header {
          padding: 24px 20px;
        }

        .content {
          padding: 28px 20px;
        }

        .footer {
          padding: 20px;
        }

        .title {
          font-size: 21px;
        }

        .invoice td {
          padding: 12px 8px;
          font-size: 13px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- ExploreBangla Logo -->
        <div class="header">
          <div class="logo">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="50"
              height="39"
              viewBox="0 0 50 39"
              fill="none"
            >
              <path
                d="M16.4992 2H37.5808L22.0816 24.9729H1L16.4992 2Z"
                fill="#FDBA74"
              />

              <path
                d="M17.4231 27.1022L11.4199 36.0002H33.5015L49.0007 13.0273H32.7031L23.2071 27.1022H17.4231Z"
                fill="#F97316"
              />
            </svg>

            <span class="logo-text"> Explore<span>Bangla</span> </span>
          </div>
        </div>

        <!-- Main Content -->
        <div class="content">
          <h1 class="title">Tour Booking Confirmed 🎉</h1>

          <p class="text">
            Thank you for booking your tour with
            <strong>ExploreBangla</strong>.
          </p>

          <p class="text">
            Your payment has been successfully received and your tour booking
            has been confirmed.
          </p>

          <!-- Payment Status -->
          <div class="success-box">
            <p class="success-title">Payment Successful</p>

            <p class="success-text">
              Your payment has been successfully processed.
            </p>
          </div>

          <!-- Invoice Information -->
          <table class="invoice">
            <tr>
              <td>Payment ID</td>

              <td><%= tran_id %></td>
            </tr>

            <tr class="amount-row">
              <td>Total Amount Paid</td>

              <td class="amount"><%= amount %></td>
            </tr>
          </table>

          <!-- Attachment Information -->
          <div class="attachment">
            <strong>Invoice PDF attached:</strong>
            Your official booking invoice is attached to this email. Please
            download and keep it for your records.
          </div>

          <p class="text" style="margin-top: 24px">
            We hope you have an amazing journey with ExploreBangla!
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            © <%= new Date().getFullYear() %>
            <span class="brand">ExploreBangla</span>. All rights reserved.
          </p>

          <p class="footer-text">
            Explore Bangladesh. Discover unforgettable journeys.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
