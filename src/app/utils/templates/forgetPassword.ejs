<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Reset Your ExploreBangla Password</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family: Arial, Helvetica, sans-serif;
        color: #1e293b;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
        box-sizing: border-box;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
      }

      .header {
        padding: 28px 32px;
        border-bottom: 1px solid #f1f5f9;
        text-align: center;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
      }

      .logo-text {
        font-size: 20px;
        font-weight: 600;
        color: #1e293b;
        vertical-align: middle;
      }

      .logo-text span {
        color: #f97316;
      }

      .content {
        padding: 36px 32px;
      }

      .title {
        margin: 0 0 16px;
        font-size: 24px;
        line-height: 1.3;
        font-weight: 700;
        color: #0f172a;
      }

      .text {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: #475569;
      }

      .button-wrapper {
        text-align: center;
        margin: 28px 0;
      }

      .button {
        display: inline-block;
        padding: 13px 26px;
        background-color: #f97316;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
      }

      .warning {
        margin-top: 24px;
        padding: 14px 16px;
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        border-radius: 6px;
        font-size: 13px;
        line-height: 1.6;
        color: #7c2d12;
      }

      .footer {
        padding: 22px 32px;
        background-color: #f8fafc;
        text-align: center;
        border-top: 1px solid #f1f5f9;
      }

      .footer-text {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #94a3b8;
      }

      .brand {
        color: #f97316;
        font-weight: 600;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 12px;
        }

        .header {
          padding: 24px 20px;
        }

        .content {
          padding: 28px 20px;
        }

        .footer {
          padding: 20px;
        }

        .title {
          font-size: 21px;
        }

        .text {
          font-size: 14px;
        }

        .button {
          display: block;
          width: 100%;
          box-sizing: border-box;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header / Logo -->
        <div class="header">
          <div class="logo">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="50"
              height="39"
              viewBox="0 0 50 39"
              fill="none"
              style="vertical-align: middle"
            >
              <g>
                <path
                  d="M16.4992 2H37.5808L22.0816 24.9729H1L16.4992 2Z"
                  fill="#FDBA74"
                />
                <path
                  d="M17.4231 27.1022L11.4199 36.0002H33.5015L49.0007 13.0273H32.7031L23.2071 27.1022H17.4231Z"
                  fill="#F97316"
                />
              </g>
            </svg>

            <span class="logo-text"> Explore<span>Bangla</span> </span>
          </div>
        </div>

        <!-- Main Content -->
        <div class="content">
          <h1 class="title">Reset Your Password</h1>

          <p class="text">Hello <strong><%= name %></strong>,</p>

          <p class="text">
            We received a request to reset the password for your
            <strong>ExploreBangla</strong> account. Click the button below to
            create a new password.
          </p>

          <!-- Reset Button -->
          <div class="button-wrapper">
            <a
              href="<%= resetUrl %>"
              class="button"
              target="_blank"
              rel="noopener noreferrer"
            >
              Reset Password
            </a>
          </div>

          <p class="text">
            This password reset link will expire in
            <strong>10 minutes</strong>.
          </p>

          <div class="warning">
            If you did not request a password reset, you can safely ignore this
            email. Your account password will remain unchanged.
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            © <%= new Date().getFullYear() %>
            <span class="brand">ExploreBangla</span>. All rights reserved.
          </p>

          <p class="footer-text">
            Explore Bangladesh. Discover unforgettable journeys.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
